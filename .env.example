# .env папки сайта: D:\Sites\<сайт>\.env; запуск: node scripts/tilda.mjs --site D:\Sites\<сайт> <команда>
TILDA_PROJECT_ID=
# Защищённые страницы через запятую; пустое значение — ни одна страница не защищена (задавать явно)
TILDA_PROTECTED_PAGES=
TILDA_DEFAULT_PAGE=
# Общий каталог шаблонов для всех сайтов
TILDA_CATALOG_DIR=D:\Sites\_shared\catalog
# Пути ниже по умолчанию лежат в папке сайта; относительные считаются от неё
# TILDA_BASELINE_DIR=./site-baseline
# TILDA_REFERENCE_DIR=./site-reference
# TILDA_BROWSER_PROFILE=./.browser-profile
# Перенос через кабинет донора
# TILDA_DONOR_PROJECT_ID=
# TILDA_DONOR_BROWSER_PROFILE=./.browser-profile-donor
LOG_LEVEL=INFO
