# Site folder .env: D:\Sites\<site>\.env; run: node scripts/tilda.mjs --site D:\Sites\<site> <command>
TILDA_PROJECT_ID=
# Protected pages, comma-separated; an empty value means no page is protected (set it explicitly)
TILDA_PROTECTED_PAGES=
TILDA_DEFAULT_PAGE=
# Template catalog shared by all sites
TILDA_CATALOG_DIR=D:\Sites\_shared\catalog
# The paths below default to the site folder; relative paths are resolved from it
# TILDA_BASELINE_DIR=./site-baseline
# TILDA_REFERENCE_DIR=./site-reference
# TILDA_BROWSER_PROFILE=./.browser-profile
# Transfer through the donor account
# TILDA_DONOR_PROJECT_ID=
# TILDA_DONOR_BROWSER_PROFILE=./.browser-profile-donor
LOG_LEVEL=INFO
# CLI message language: en or ru. Empty — the system language (ru* → ru, otherwise en).
TILDA_LANG=
