# Synthetic IDs only. Replace with IDs from your own Tilda project.
# This file is not loaded automatically.
# Node 24: node --env-file=.env scripts/tilda.mjs --help
TILDA_PROJECT_ID=100001
TILDA_DEFAULT_PAGE=200002
TILDA_PROTECTED_PAGES=200001

# Optional paths; defaults are local to this toolkit directory.
# TILDA_BASELINE_DIR=./site-baseline
# TILDA_BROWSER_PROFILE=./.browser-profile
# TILDA_REFERENCE_DIR=./site-reference

# Donor account (transfer via donor cabinet). Synthetic IDs only.
